# ---- Hugging Face token (optional but recommended) -------------------------
# Create a *fine-grained* token at https://huggingface.co/settings/tokens and tick
#   "Make calls to Inference Providers".
# Leave this empty to run in retrieval-only (extractive) mode.
HUGGINGFACEHUB_API_TOKEN=

# ---- Optional overrides (defaults shown) -----------------------------------
# LLM_REPO_ID=meta-llama/Llama-3.1-8B-Instruct
# LLM_PROVIDER=auto
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=700
# DEFAULT_K=4
# API_HOST=0.0.0.0
# API_PORT=7860
